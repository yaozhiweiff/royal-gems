{
  "name": "royal-gems-api",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "vars": { "ALLOWED_ORIGINS": "http://127.0.0.1:5173,http://127.0.0.1:4173" },
  "d1_databases": [{ "binding": "DB", "database_name": "royal-gems", "database_id": "REPLACE_WITH_D1_DATABASE_ID", "migrations_dir": "migrations" }]
}
